# Local Glitch Topstep gateway. Never put ProjectX credentials in this profile.
GLITCH_TOPSTEP_GATEWAY_URL=http://127.0.0.1:8790
GLITCH_TOPSTEP_LOCAL_TOKEN=replace-with-the-same-local-token-used-by-glitch-topstep

# Runtime and scheduling controls. Cadence controls observation frequency, not eligibility.
GLITCH_TOPSTEP_REQUEST_TIMEOUT_SECONDS=20
GLITCH_TOPSTEP_MODEL_TIMEOUT_SECONDS=240
GLITCH_TOPSTEP_PACKET_MAX_AGE_SECONDS=90
GLITCH_TOPSTEP_FRAME_RETENTION=180
GLITCH_TOPSTEP_FLAT_DECISION_INTERVAL_MINUTES=1

# Default bounded cognition route. Changes must remain explicit; never silently downgrade.
GLITCH_TOPSTEP_CORE_MODEL=gpt-5.6-luna
GLITCH_TOPSTEP_CORE_PROVIDER=openai-codex

# Canonical completed outcomes may be supplied by the gateway when implemented.
GLITCH_TOPSTEP_OUTCOMES_PATH=

# Cognitive changes are proposed by default. Hermes remains free to reason and learn;
# this switch controls automatic activation of persisted overlays only.
GLITCH_TOPSTEP_AUTO_ACTIVATE_OVERLAY=false
GLITCH_TOPSTEP_OVERLAY_MIN_EPISODES=6
