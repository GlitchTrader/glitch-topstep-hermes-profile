# Local deterministic gateway. Never put ProjectX credentials in this profile.
GLITCH_TOPSTEP_GATEWAY_URL=http://127.0.0.1:8790
GLITCH_TOPSTEP_LOCAL_TOKEN=replace-with-the-same-local-token-used-by-glitch-topstep

# Optional runtime controls.
GLITCH_TOPSTEP_REQUEST_TIMEOUT_SECONDS=20
GLITCH_TOPSTEP_MODEL_TIMEOUT_SECONDS=240
GLITCH_TOPSTEP_PACKET_MAX_AGE_SECONDS=90
GLITCH_TOPSTEP_FRAME_RETENTION=180
GLITCH_TOPSTEP_OUTCOMES_PATH=

# Cognitive changes are proposed by default, not automatically activated.
GLITCH_TOPSTEP_AUTO_ACTIVATE_OVERLAY=false
GLITCH_TOPSTEP_OVERLAY_MIN_EPISODES=6
