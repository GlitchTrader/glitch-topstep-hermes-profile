{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glitch.topstep.normalized_candidate.v1",
  "title": "Normalized ensemble candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "profile_id",
    "profile_version",
    "invocation_id",
    "envelope_id",
    "envelope_hash",
    "state",
    "instrument",
    "comparability",
    "completeness_used",
    "started_utc",
    "finished_utc",
    "latency_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "glitch.topstep.normalized_candidate.v1"
    },
    "run_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_version": { "type": "string" },
    "invocation_id": { "type": "string" },
    "envelope_id": { "type": "string" },
    "envelope_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "held",
        "no_edge",
        "missing_required_evidence",
        "data_quality_insufficient",
        "expired",
        "timeout",
        "error",
        "invalid"
      ]
    },
    "instrument": { "type": "string" },
    "comparability": {
      "type": "string",
      "enum": ["comparable", "not_comparable"]
    },
    "profile_declared_state": { "type": ["string", "null"] },
    "profile_declared_direction": {
      "type": ["string", "null"],
      "enum": ["long", "short", "flat", "hold", null]
    },
    "capacity_gate_reason": { "type": ["string", "null"] },
    "direction": {
      "type": ["string", "null"],
      "enum": ["long", "short", "flat", "hold", null]
    },
    "thesis": { "type": ["string", "null"] },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entry": { "type": ["number", "null"] },
    "entry_range": {
      "type": ["object", "null"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "stop": { "type": ["number", "null"] },
    "target": { "type": ["number", "null"] },
    "horizon_bars": { "type": ["integer", "null"] },
    "invalidation": { "type": ["string", "null"] },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forecast": { "type": ["object", "null"] },
    "completeness_used": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "raw_status": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "started_utc": { "type": "string" },
    "finished_utc": { "type": "string" },
    "latency_ms": { "type": "integer", "minimum": 0 }
  }
}
