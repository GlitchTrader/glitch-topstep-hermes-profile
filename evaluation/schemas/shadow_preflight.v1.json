{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "glitch.topstep.shadow_preflight.v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "ready",
    "status",
    "shadow_live_execution_authorized",
    "promotion_use_allowed"
  ],
  "properties": {
    "schema_version": { "const": "glitch.topstep.shadow_preflight.v1" },
    "run_id": { "type": "string" },
    "ready": { "type": "boolean" },
    "status": { "type": "string" },
    "shadow_live_execution_authorized": { "const": false },
    "gateway_started": { "const": false },
    "hermes_started": { "const": false },
    "promotion_use_allowed": { "const": false },
    "production_parallelism": { "const": "blocked" },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
