{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glitch.topstep.ensemble_registry.v1",
  "title": "Ensemble registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "evaluation_only",
    "promotion_status",
    "execution_mode",
    "storage_root",
    "runner",
    "baseline_policy",
    "capability_matrix_version",
    "envelope_schema",
    "candidate_schema",
    "selection_schema",
    "aggregator_rules_version",
    "config_version",
    "profiles"
  ],
  "properties": {
    "schema_version": { "const": "glitch.topstep.ensemble_registry.v1" },
    "registry_version": { "type": "string", "minLength": 1 },
    "evaluation_only": { "const": true },
    "promotion_status": {
      "type": "string",
      "enum": ["blocked", "shadow_only", "proposed", "approved"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["offline_sequential", "offline_parallel", "shadow_live", "paper"]
    },
    "storage_root": { "type": "string", "minLength": 1 },
    "runner": { "type": "string", "minLength": 1 },
    "baseline_policy": { "type": "string", "minLength": 1 },
    "capability_matrix_version": { "type": "string", "minLength": 1 },
    "envelope_schema": { "type": "string", "minLength": 1 },
    "candidate_schema": { "type": "string", "minLength": 1 },
    "selection_schema": { "type": "string", "minLength": 1 },
    "aggregator_rules_version": { "type": "string", "minLength": 1 },
    "config_version": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "deferred_profiles": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_kind",
        "role",
        "prompt_version",
        "enabled",
        "skills",
        "evidence_requirements_ref"
      ],
      "properties": {
        "profile_id": { "type": "string" },
        "profile_version": { "type": "string" },
        "profile_kind": {
          "type": "string",
          "enum": ["baseline", "directional", "reviewer", "observer"]
        },
        "role": { "type": "string" },
        "prompt_version": { "type": "string" },
        "enabled": { "type": "boolean" },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "evidence_requirements_ref": { "type": "string" }
      }
    }
  }
}
